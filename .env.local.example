# Copiar para .env.local e preencher com os dados do projeto Supabase
# (Project Settings → API). A chave anon é pública por definição: quem protege
# os dados é a Row Level Security, não o segredo da chave.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Serve qualquer um dos dois nomes: o painel novo dá PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
